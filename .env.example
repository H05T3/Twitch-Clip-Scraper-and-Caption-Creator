# Copy this file to ".env" and fill in your own values. ".env" is git-ignored.

# ---- Secrets ----
OPENAI_API_KEY=your_openai_key_here
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# ---- Folders (relative to the project root, or absolute) ----
SAVED_CLIPS_DIR=APP/SavedClips
WORKSPACE_DIR=APP/Workspace
SETTINGS_FILE=APP/settings.json
PROMPT_FILE=APP/Assets/prompts/analysis_prompt.txt

# ---- User settings ----
THEME=dark
CLIP_COUNT=5
CLIP_LOOKBACK_DAYS=30
MAX_CLIP_PAGES=5

# ---- Output video ----
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
VIDEO_CRF=21
VIDEO_PRESET=veryfast
AUDIO_BITRATE=160k
BACKGROUND_BLUR=30
BACKGROUND_DIM=0.55
VIDEO_Y_OFFSET=0

# ---- Title banner (top) ----
TITLE_FONT=DejaVu Sans
TITLE_FONT_SIZE=64
TITLE_TEXT_COLOR=#FFFFFF
TITLE_BANNER_COLOR=#000000
TITLE_BANNER_OPACITY=0.75
TITLE_TOP_MARGIN=140
TITLE_SIDE_MARGIN=60
TITLE_MAX_CHARS=60

# ---- Subtitles (bottom third) ----
SUBTITLE_FONT=DejaVu Sans
SUBTITLE_FONT_SIZE=78
SUBTITLE_TEXT_COLOR=#FFFFFF
SUBTITLE_HIGHLIGHT_COLOR=#FFE100
SUBTITLE_OUTLINE_COLOR=#000000
SUBTITLE_OUTLINE_WIDTH=6
SUBTITLE_BOTTOM_MARGIN=420
SUBTITLE_SIDE_MARGIN=70
SUBTITLE_MAX_WORDS=4
SUBTITLE_MAX_CHARS=16
SUBTITLE_MAX_GAP_SECONDS=0.8
SUBTITLE_UPPERCASE=true

# ---- Zoom effect ----
ZOOM_ENABLED=true
ZOOM_MAX_FACTOR=1.6
ZOOM_MAX_REGIONS=3

# ---- AI ----
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=
ANALYSIS_MODEL=gpt-4o-mini
ANALYSIS_TEMPERATURE=0.3
AUDIO_FORMAT=mp3
AUDIO_SAMPLE_RATE=16000
AUDIO_BITRATE_EXTRACT=64k

# ---- Twitch ----
TWITCH_API_BASE=https://api.twitch.tv/helix
TWITCH_TOKEN_URL=https://id.twitch.tv/oauth2/token
TWITCH_PAGE_SIZE=100
HTTP_TIMEOUT_SECONDS=20
DOWNLOAD_QUALITY=best[height<=1080]/best

# ---- Tools ----
# Leave as "ffmpeg" to use the one on your PATH (or the bundled imageio-ffmpeg copy).
# Or set a full path, e.g. C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_BINARY=ffmpeg
